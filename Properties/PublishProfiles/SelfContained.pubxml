<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces a single self-contained Artemis.exe for offline Windows x64 machines.
  The .NET 9 runtime and all native libraries are embedded, so the target machine
  needs no .NET installation and no network access.

  Publish with:  dotnet publish -p:PublishProfile=SelfContained
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PublishDir>publish\win-x64</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Pulls Avalonia/Skia/SQLite native .dlls inside the exe instead of beside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>

    <!-- Must stay false: ViewLocator resolves views by reflection, which trimming breaks. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
